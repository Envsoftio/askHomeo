POSTGRES_PASSWORD=localdev
API_TOKEN=replace-with-a-random-admin-token-at-least-24-characters
REVIEWER_TOKEN=replace-with-a-different-random-reviewer-token
ADMIN_NAME=Your administrator name
REVIEWER_NAME=Your reviewer name
# For multiple named API users, set AUTH_PRINCIPALS_JSON to a JSON array of
# {"id":"stable-uuid","name":"Person name","role":"admin|reviewer","token":"secret-at-least-24-characters"}.
# The browser sign-in accepts each configured token. It is kept in an HttpOnly local session cookie.
# OpenRouter serves chat and embeddings; no local model server is required.
EMBEDDING_PROVIDER=openrouter
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_INPUT_STYLE=plain
EMBEDDING_REVISION=openrouter-baai-bge-m3-unpinned
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Change CHAT_MODEL to any OpenRouter chat model ID to compare models.
# CHAT_REVISION defaults to a provider/model-specific "unpinned" marker.
CHAT_MAX_TOKENS=4096
CHAT_REASONING_EFFORT=none
MODEL_REQUEST_TIMEOUT_SECONDS=300
