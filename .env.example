PROJECT_ROOT=/absolute/path/to/Homeopath_POC
DATABASE_URL=postgres://homeopath:localdev@127.0.0.1:5437/homeopath?sslmode=disable
API_TOKEN=replace-with-a-random-admin-token-at-least-24-characters
API_ADDR=:8080
API_PROXY_TARGET=http://127.0.0.1:8080
REVIEWER_TOKEN=replace-with-a-different-random-reviewer-token
ADMIN_NAME=Your administrator name
REVIEWER_NAME=Your reviewer name
# For multiple named API users, set AUTH_PRINCIPALS_JSON to a JSON array of
# {"id":"stable-uuid","name":"Person name","role":"admin|reviewer","token":"secret-at-least-24-characters"}.
# The browser sign-in accepts each configured token. It is kept in an HttpOnly local session cookie.
AI_BASE_URL=http://127.0.0.1:1234/v1
# For Docker Compose, use AI_BASE_URL=http://host.docker.internal:1234/v1.
AI_PROVIDER=lmstudio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_REVISION=nomic-ai/nomic-embed-text-v1.5-GGUF/nomic-embed-text-v1.5.Q4_K_M.gguf
EMBEDDING_DIMENSIONS=768
CHAT_MODEL=qwen/qwen3-14b
CHAT_REVISION=lmstudio-community/Qwen3-14B-GGUF/Qwen3-14B-Q4_K_M.gguf@sha256:712c0791d5124d3dd6d1e4968de1201207afeae49c6e10fbeb9c58fe00c58555
