# Copy to .env.prod on the server. Keep .env.prod private.
# Use URL-safe random values for these credentials.
# Linux host networking: these three ports must be free and distinct.
POSTGRES_PORT=5437
API_PORT=8082
FRONTEND_PORT=8088
# Default: put a host HTTPS reverse proxy in front of http://127.0.0.1:8088.
# Set 0.0.0.0 to make ONLY the frontend reachable directly on port 8088.
# Non-root host-network containers require ports >= 1024.
FRONTEND_BIND_ADDR=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
API_TOKEN=replace-with-a-random-admin-token-at-least-24-characters
REVIEWER_TOKEN=replace-with-a-different-random-reviewer-token
ADMIN_NAME=Administrator
REVIEWER_NAME=Reviewer
# Optional named users; see .env.example. Single-quote JSON in this env file.
AUTH_PRINCIPALS_JSON=
AI_PROVIDER=deepinfra
# Required only when AI_PROVIDER=deepinfra; omit or leave blank for lmstudio.
DEEPINFRA_API_KEY=replace-with-your-deepinfra-api-key
# Used only with AI_PROVIDER=lmstudio. Set matching local models below as well.
AI_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=BAAI/bge-m3
# DeepInfra does not expose an immutable revision for this endpoint.
EMBEDDING_REVISION=deepinfra-bge-m3-unpinned
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=openai/gpt-oss-120b
CHAT_REVISION=deepinfra-gpt-oss-120b-unpinned
# For LM Studio, replace ALL five model settings above with your loaded models.
# Example (also set AI_PROVIDER=lmstudio and omit DEEPINFRA_API_KEY):
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_REVISION=nomic-ai/nomic-embed-text-v1.5-GGUF/nomic-embed-text-v1.5.Q4_K_M.gguf
# EMBEDDING_DIMENSIONS=768
# CHAT_MODEL=qwen/qwen3-14b
# CHAT_REVISION=qwen3-14b-local
