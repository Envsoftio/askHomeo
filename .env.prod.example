# Copy to .env.prod on the server. Keep .env.prod private.
# Use URL-safe random values for these credentials.
# Linux host networking: these three ports must be free and distinct.
POSTGRES_PORT=5437
API_PORT=8082
FRONTEND_PORT=8088
# Default: put a host HTTPS reverse proxy in front of http://127.0.0.1:8088.
# Set 0.0.0.0 to make ONLY the frontend reachable directly on port 8088.
# Non-root host-network containers require ports >= 1024.
FRONTEND_BIND_ADDR=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional bearer token for API scripts (at least 24 characters when set).
API_TOKEN=
REVIEWER_TOKEN=replace-with-a-different-random-reviewer-token
ADMIN_NAME=Administrator
REVIEWER_NAME=Reviewer
# Optional named users; see .env.example. Single-quote JSON in this env file.
AUTH_PRINCIPALS_JSON=
AI_PROVIDER=deepinfra
EMBEDDING_PROVIDER=deepinfra
CHAT_PROVIDER=deepinfra
DEEPINFRA_API_KEY=replace-with-your-deepinfra-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_INPUT_STYLE=plain
EMBEDDING_REVISION=deepinfra-BAAI-bge-m3-plain-v1
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=zai-org/GLM-5.3
CHAT_REVISION=deepinfra-zai-org-GLM-5.3-unpinned
CHAT_MAX_TOKENS=4096
CHAT_REASONING_EFFORT=low
MODEL_REQUEST_TIMEOUT_SECONDS=300
# CHAT_PROVIDER and EMBEDDING_PROVIDER override AI_PROVIDER; set both when switching.
# For LM Studio, set AI_PROVIDER=lmstudio, AI_BASE_URL=http://127.0.0.1:1234/v1,
# and replace ALL five model settings above with your loaded models.
# Example:
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBEDDING_REVISION=nomic-ai/nomic-embed-text-v1.5-GGUF/nomic-embed-text-v1.5.Q4_K_M.gguf
# EMBEDDING_DIMENSIONS=768
# CHAT_MODEL=qwen/qwen3-14b
# CHAT_REVISION=qwen3-14b-local

# Private Backblaze B2 bucket; use a bucket-scoped application key, not a master key.
PDF_STORAGE_PROVIDER=b2
B2_REGION=us-west-004
B2_BUCKET=replace-with-private-bucket-name
B2_KEY_ID=
B2_APPLICATION_KEY=
# API and worker need the same bucket/region. Explicit local mode is development-only.
