# Copy to production.env on the server. Keep production.env private.
# Use URL-safe random values for these credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
API_TOKEN=replace-with-a-random-admin-token-at-least-24-characters
REVIEWER_TOKEN=replace-with-a-different-random-reviewer-token
ADMIN_NAME=Administrator
REVIEWER_NAME=Reviewer
EMBEDDING_PROVIDER=openrouter
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_INPUT_STYLE=plain
# Set a new revision and reindex if the embedding model or its provider changes.
EMBEDDING_REVISION=openrouter-baai-bge-m3-unpinned
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CHAT_MAX_TOKENS=4096
CHAT_REASONING_EFFORT=none
MODEL_REQUEST_TIMEOUT_SECONDS=300
